# ============================================================================
# StudySync - Variáveis de ambiente do Frontend
# Copie para `.env` (ou `.env.local`). Somente prefixos VITE_ são expostos
# ao navegador — nunca coloque segredos aqui.
# ============================================================================

# URL base da API.
# Deixe VAZIO para usar o proxy do Vite (recomendado em desenvolvimento):
# as chamadas vão para /api e o Vite encaminha para http://127.0.0.1:8000.
#
# Preencha apenas se o backend estiver em outro host/porta sem proxy,
# por exemplo: VITE_API_URL=http://192.168.0.10:8000
VITE_API_URL=

# URL do WebSocket de notificações.
# Deixe VAZIO para derivar automaticamente de VITE_API_URL / origem atual.
# Exemplo manual: VITE_WS_URL=ws://192.168.0.10:8000/api/ws/notifications
VITE_WS_URL=
