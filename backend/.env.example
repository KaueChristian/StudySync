# ============================================================================
# StudySync - Variáveis de ambiente do Backend
# Copie este arquivo para `.env` e ajuste os valores.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# ============================================================================

# --- Ambiente: development | production ---
ENV=development

# ----------------------------------------------------------------------------
# SEGURANÇA
# ----------------------------------------------------------------------------
# OBRIGATÓRIO em produção. Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Se ficar vazio em desenvolvimento, uma chave aleatória é gerada a cada boot
# (todos os tokens emitidos serão invalidados ao reiniciar o servidor).
SECRET_KEY=

# Tempo de vida dos tokens JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------------------------------------
# SQLite relativo à pasta /backend
DATABASE_URL=sqlite:///./studysync.db

# ----------------------------------------------------------------------------
# CORS - origens autorizadas do frontend (separadas por vírgula)
# ----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------------------
# AGENDADOR / LEMBRETES
# ----------------------------------------------------------------------------
# Intervalo (segundos) da varredura de lembretes pendentes
REMINDER_POLL_SECONDS=30
# Janela de tolerância (minutos) para disparar lembretes atrasados
# (ex.: servidor ficou offline). Fora dessa janela o lembrete é descartado.
REMINDER_GRACE_MINUTES=120

# ----------------------------------------------------------------------------
# MOTOR DE BUSCA / SCRAPING
# ----------------------------------------------------------------------------
SCRAPER_TIMEOUT=12.0
SCRAPER_CACHE_TTL=900
SCRAPER_MAX_RESULTS=5
# Região usada nas buscas (br-pt = Brasil/Português)
SCRAPER_REGION=br-pt

# ----------------------------------------------------------------------------
# RATE LIMIT (proteção contra brute-force nas rotas de autenticação)
# ----------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60
